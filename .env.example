# Copy to .env and fill in. .env is gitignored — keep it on your own machine only.

# Your school's Clickedu URL, e.g. https://yourschool.clickedu.eu
CLICKEDU_BASE_URL=https://YOURSCHOOL.clickedu.eu

# Your own staff login.
CLICKEDU_USERNAME=
CLICKEDU_PASSWORD=

# Numeric user id Clickedu assigns you. Leave blank — it is scraped on first login
# and printed so you can pin it here afterwards.
CLICKEDU_ID_USUARI=

# Absolute path to your pass file (the "arxiu de pas" Clickedu issued you).
CLICKEDU_PASSFILE=/absolute/path/to/your/arxiu_de_pas.txt

# Where to persist the cookie jar (keep it off any shared/synced folder).
CLICKEDU_COOKIE_PATH=.cookies/session.jar

# Transport: leave unset for stdio (local use with Claude Desktop / Claude Code).
# Set to streamable-http to serve over HTTP at /mcp (put it behind auth if exposed).
# CLICKEDU_TRANSPORT=streamable-http
# CLICKEDU_HTTP_HOST=127.0.0.1
# CLICKEDU_HTTP_PORT=8791
