# Copy to .env and fill in. .env is gitignored — keep it on your laptop only.
CLICKEDU_BASE_URL=https://jpif.clickedu.eu
CLICKEDU_USERNAME=
CLICKEDU_PASSWORD=
# Numeric user id Clickedu assigns you (scraped on first login if left blank).
CLICKEDU_ID_USUARI=
# Absolute path to your pass file (arxiu de pas) on this machine.
CLICKEDU_PASSFILE=
# Where to persist the cookie jar (keep off any shared/synced folder).
CLICKEDU_COOKIE_PATH=.cookies/session.jar
